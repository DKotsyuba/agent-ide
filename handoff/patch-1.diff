+/// A first check held at an explicit gate cannot promise a working environment. After commit,
+/// inline expiry names the files and check stage; one bounded inspect expires without cancelling
+/// work, then a released check settles inside the next bound. The CLI exposes its slow stage.
+#[tokio::test]
+async fn edit_progress_and_bounded_inspect_preserve_committed_files() {
+    let fixture = ProductFixture::new(json!([]));
+    let home =
+        enable_fake_rust_checks_holding(&fixture, &fixture.base, &hold_checks_at_gate(&fixture));
+    let mut daemon = fixture.daemon_with_home(Some(&home)).await;
+    let mut actor = ProductActor::new(&fixture, "stage-progress").await;
+    let start = actor.call(&fixture, "ide.start", json!({})).await;
+    assert_eq!(actor.settle(&fixture, start).await["kind"], "activation");
+    let reply = actor
+        .call(
+            &fixture,
+            "ide.edit",
+            json!({"files":[
+        {"path":"src/lib.rs","changes":[{"old":"{ 7 }","new":"{ 8 }"}]}]}),
+        )
+        .await;
+    assert_eq!(reply["kind"], "edit_progress", "{reply}");
+    let text = reply["text"].as_str().unwrap();
+    assert!(
+        text.contains("committed: src/lib.rs") && text.contains("stage: check"),
+        "{reply}"
+    );
+    assert!(!text.contains("diagnostics: pending"), "{reply}");
+    assert!(
+        std::fs::read_to_string(fixture.root.join("src/lib.rs"))
+            .unwrap()
+            .contains("8")
+    );
+    let reference = reply["detail_ref"].as_str().unwrap();
+    let began = std::time::Instant::now();
+    let pending = actor
+        .call(
+            &fixture,
+            "ide.inspect",
+            json!({"detail_ref":reference,"wait_s":1}),
+        )
+        .await;
+    assert!(
+        began.elapsed() >= Duration::from_millis(900) && began.elapsed() < Duration::from_secs(2),
+        "{:?}: {pending}",
+        began.elapsed()
+    );
+    assert_eq!(pending["kind"], "edit_progress", "{pending}");
+    let began = std::time::Instant::now();
+    let pending_batch = actor
+        .call(
+            &fixture,
+            "ide.inspect",
+            json!({"detail_refs":[reference,reference],"wait_s":1}),
+        )
+        .await;
+    assert!(
+        began.elapsed() >= Duration::from_millis(900) && began.elapsed() < Duration::from_secs(2),
+        "{:?}: {pending_batch}",
+        began.elapsed()
+    );
+    assert_eq!(pending_batch["kind"], "inspect", "{pending_batch}");
+    assert!(
+        pending_batch["text"]
+            .as_str()
+            .unwrap()
+            .contains("committed: src/lib.rs"),
+        "{pending_batch}"
+    );
+    release_checks_gate(&fixture);
+    let began = std::time::Instant::now();
+    let settled = actor
+        .call(
+            &fixture,
+            "ide.inspect",
+            json!({"detail_ref":reference,"wait_s":30}),
+        )
+        .await;
+    assert!(began.elapsed() < Duration::from_secs(30), "{settled}");
+    assert_eq!(settled["state"], "edit_batch", "{settled}");
+    assert_eq!(settled["files"][0]["path"], "src/lib.rs", "{settled}");
+    assert_eq!(settled["files"][0]["state"], "replaced", "{settled}");
+    let errors = Command::new(product_binary())
+        .args(["errors", "--repo"])
+        .arg(&fixture.runtime)
+        .env(agent_ide::userhome::HOME_OVERRIDE_ENV, &home)
+        .output()
+        .await
+        .unwrap();
+    let errors_text = String::from_utf8_lossy(&errors.stdout);
+    assert!(
+        errors.status.success()
+            && errors_text.contains("stage: check")
+            && errors_text.contains("inline_wait_exceeded: true"),
+        "{errors:?}"
+    );
+    actor.call(&fixture, "ide.stop", json!({})).await;
+    actor.mcp.close().await;
+    daemon.kill().await.unwrap();
+    daemon.wait().await.unwrap();
+}
