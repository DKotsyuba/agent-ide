  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Atomic multi-file edit: batch production and test changes in one apply_patch `patch` (*** Begin Patch, *** Add File or *** Update File, *** End Patch); delete and move are unsupported. Absolute file headers inside the worktree are accepted; outside paths refuse. At the inline wait limit the reply is edit_progress: requested and committed files, stage and detail_ref; the project check reports separately.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "description": "Retry key; never applied twice.",
          "type": "string"
        },
        "patch": {
          "description": "A Codex apply_patch body (Add File, Update File), applied atomically. Use it alone.",
          "type": "string"
        }
      },
      "required": [
        "patch"
      ],
      "type": "object"
    },
    "name": "ide.edit"
  },
  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    },
