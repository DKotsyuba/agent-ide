            "rust",
            "python",
            "typescript"
          ],
          "type": "string"
        },
        "offset": {
          "description": "Only with kind:problems; continue from next_offset.",
          "type": "integer"
        },
        "path": {
          "description": "Only with kind:diagnostics.",
          "type": "string"
        },
        "wait_s": {
          "description": "Only with detail_ref(s): completion seconds.",
          "type": "integer"
        }
      },
      "type": "object"
    },
    "name": "ide.inspect"
  },
