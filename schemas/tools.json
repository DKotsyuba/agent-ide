    "description": "Changes since your last diff, paged; `mode` gives a whole comparison. Batch related paths\nin one call; provenance:true adds the identity header.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "detail_ref": {
          "type": "string"
        },
        "mode": {
          "description": "Whole comparison: uncommitted, staged, unstaged or since activation.",
          "enum": [
            "head",
            "staged",
            "unstaged",
            "task"
          ],
          "type": "string"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "provenance": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "name": "ide.diff"
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Atomic multi-file edit: batch production and test files ({path, changes}, {path, create:true,\ncontent} or {path, content}); all apply or none. A change: {symbol, content} (op\ninsert/delete, where), exact {old, new} once (within scopes it), {lines, content},\nadd_import or remove_import. Rename: op rename, symbol, new_name. At the inline wait limit\nthe reply is edit_progress: requested and committed files, stage and detail_ref; the project\ncheck reports separately.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "description": "Up to 16 files; up to 32 changes each.",
          "items": {
            "properties": {
              "changes": {
                "items": {
                  "properties": {
                    "add_import": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    },
                    "lines": {
                      "type": "string"
                    },
                    "new": {
                      "type": "string"
                    },
                    "old": {
                      "type": "string"
                    },
                    "op": {
                      "enum": [
                        "replace",
                        "insert",
                        "delete"
                      ],
                      "type": "string"
                    },
                    "remove_import": {
                      "type": "string"
                    },
                    "symbol": {
                      "type": "string"
                    },
                    "where": {
                      "enum": [
                        "before",
                        "after",
                        "first",
                        "last"
                      ],
                      "type": "string"
                    },
                    "within": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "content": {
                "type": "string"
              },
              "create": {
                "type": "boolean"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "new_name": {
          "type": "string"
        },
        "op": {
          "default": "replace",
          "enum": [
            "replace",
            "insert",
            "delete",
            "rename"
          ],
          "type": "string"
        },
        "operation_id": {
          "description": "Retry key; never applied twice.",
          "type": "string"
        },
        "symbol": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "ide.edit"
  },
  {
    "annotations": {
