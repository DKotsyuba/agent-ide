          "type": "string"
        },
        "symbol": {
          "description": "Address or bare name.",
          "type": "string"
        },
        "symbols": {
          "description": "Up to 8.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tests": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "name": "ide.graph"
