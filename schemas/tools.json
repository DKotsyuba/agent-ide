          "enum": [
            "head",
            "staged",
            "unstaged",
            "task"
          ],
          "type": "string"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "provenance": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "name": "ide.diff"
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Atomic `files` batches (all-or-none), symbol/line/text/import edits, rename or host patch.\nLong edits return `edit_progress` with stage, requested/committed paths, and `detail_ref`;\nchecks report separately.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "description": "Up to 16 files; up to 32 changes each.",
          "items": {
            "properties": {
              "changes": {
                "items": {
                  "properties": {
                    "add_import": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    },
                    "lines": {
                      "type": "string"
                    },
                    "new": {
                      "type": "string"
                    },
                    "old": {
                      "type": "string"
                    },
                    "op": {
                      "enum": [
                        "replace",
                        "insert",
                        "delete"
                      ],
                      "type": "string"
                    },
                    "remove_import": {
                      "type": "string"
                    },
                    "symbol": {
                      "type": "string"
                    },
                    "where": {
                      "enum": [
                        "before",
                        "after",
                        "first",
                        "last"
                      ],
                      "type": "string"
                    },
                    "within": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "content": {
                "type": "string"
              },
              "create": {
                "type": "boolean"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "new_name": {
          "type": "string"
        },
        "op": {
          "default": "replace",
          "enum": [
            "replace",
            "insert",
            "delete",
            "rename"
          ],
          "type": "string"
        },
        "operation_id": {
          "description": "Retry key; never applied twice.",
          "type": "string"
        },
        "symbol": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "ide.edit"
  },
  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Call trees for a batch of symbols: callers (impact), callees (dependencies) or both; depth 2\nusually suffices (1–3); tests:true expands test nodes.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "default": 2,
          "type": "integer"
        },
        "detail_ref": {
          "type": "string"
        },
        "direction": {
          "default": "callers",
          "enum": [
            "callers",
            "callees",
            "both"
          ],
          "type": "string"
        },
        "symbol": {
          "description": "Address or bare name.",
          "type": "string"
        },
        "symbols": {
          "description": "Up to 8.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tests": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "name": "ide.graph"
  },
  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    },
