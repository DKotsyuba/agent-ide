{
  "description": "Correlate Claude tool lifecycles with the project-owned Agent IDE daemon.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT:-$(pwd)}/hooks/claude-hook.sh"}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT:-$(pwd)}/hooks/claude-hook.sh"}]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT:-$(pwd)}/hooks/claude-hook.sh"}]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "",
        "hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT:-$(pwd)}/hooks/claude-hook.sh"}]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT:-$(pwd)}/hooks/claude-hook.sh", "timeout": 330}]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT:-$(pwd)}/hooks/claude-hook.sh", "timeout": 330}]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT:-$(pwd)}/hooks/claude-hook.sh"}]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|clear",
        "hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT:-$(pwd)}/hooks/claude-hook.sh"}]
      }
    ]
  }
}
