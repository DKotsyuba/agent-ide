{
  "description": "Correlate Claude tool lifecycles with the project-owned Agent IDE daemon.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook.sh", "args": []}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook.sh", "args": []}]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook.sh", "args": []}]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "",
        "hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook.sh", "args": []}]
      }
    ]
  }
}
