{%- elif code == "provider_loading" -%}
error: provider_loading{% if resolution_detail %} ({{ resolution_detail }}){% else %} (symbol:provider_loading){% endif %}; the language server is still loading the workspace; repeat the call in a few seconds
{%- elif code == "invalid_detail" and resolution_detail == "start:activation_conflict" -%}
