{%- elif code == "invalid_detail" -%}
error: invalid_detail{% if resolution_detail %} ({{ resolution_detail }}){% else %} (inspect:detail_unknown){% endif %}; {% if resolution_detail == "inspect:detail_expired" %}this detail_ref has expired{% else %}this detail_ref was never issued{% endif %}; repeat the original ide.* call to get a fresh one, or continue with native tools
{%- elif code == "source_unavailable" and resolution_detail is startingwith("inspect:source_changed:") -%}
error: source_unavailable (inspect:source_changed); {{ resolution_message }} changed since this result was captured. Call ide.context with this path again for fresh bytes
{%- elif code == "source_unavailable" and resolution_detail == "inspect:source_changed" -%}
error: source_unavailable (inspect:source_changed); the source changed since this result was captured. Call ide.context again for fresh bytes
{%- elif code == "source_unavailable" and resolution_detail == "diff:not_a_git_repository" -%}
error: source_unavailable (diff:not_a_git_repository); not a git repository: no git data
{%- elif code == "source_unavailable" and resolution_detail is startingwith("context:source_changed:") -%}
error: source_unavailable (context:source_changed); {{ resolution_message }} changed since it was read. Re-read it with ide.context, then retry with the new source_ref
{%- elif code == "source_unavailable" and (resolution_detail == "context:source_changed" or resolution_detail == "inspect:source_stale") -%}
