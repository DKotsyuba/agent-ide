{#-
Projects one serialized Assistance `PeerReply` (tagged by `state`) into the exact deterministic
compact model-facing text the MCP facade has always emitted. The context is the complete
serialized reply, plus `cause_tag` for a tagged execution-profile refusal whose structured copy
keeps the stable public `code`, and for an `unavailable: host_binding` reply's closed cause
(T15B), whose structured copy keeps its historical fields.

Contract:
- Byte-identical to the retired manual formatter; tests in `src/assistance/content.rs` assert
  exact wording, ordering, references, and the serialized reply budget.
- Every reference must be defined for the state branch that reads it (strict undefined fails
  the render instead of silently dropping a fact): `result.source_ref` is present for every
  success outcome because `EditResult::new` enforces it, `detail_ref` serializes as `null`
  rather than being omitted.
- Untrusted reply text (`text`, `messages`, refs) is bound as data only; it is never
  template source and auto-escaping stays off because the carrier is plain text.
- Whitespace discipline: every block tag carries both trim modifiers and all lines are
  flush-left, so the only newlines in the output are the intentional ones.
-#}
{%- if state == "unavailable" -%}
unavailable: {{ reason }}{% if cause_tag %} ({{ cause_tag }}){% endif %}; continue with native tools
{%- endif -%}
{%- if state == "hook_observed" -%}
hook_observed: native pre-hook retained
{%- endif -%}
{%- if state == "hook_settled" -%}
hook_settled: validated invocation settled
{%- endif -%}
{%- if state == "native_hook_observed" -%}
native_hook_observed: registered-path reconciliation requested
{%- endif -%}
{%- if state == "feedback" -%}
feedback: {{ text }}
{%- endif -%}
{%- if state == "host_stopped" -%}
host_stopped: host binding released; no workspace authority was created
{%- endif -%}
{%- if state == "pending" -%}
pending: use ide.inspect with detail_ref {{ detail_ref }}
{%- endif -%}
{%- if state == "error" -%}
{%- if code == "resolution_unverified" -%}
error: resolution_unverified; {{ resolution_detail if resolution_detail else "the nearest tsconfig.json or jsconfig.json did not prove membership: add the file to `files` or a literal `include` entry and use supported resolution settings" }}; retry ide.context
{%- elif code.no_such_file is defined -%}
error: no_such_file: {{ code.no_such_file }}{% if resolution_detail %} ({{ resolution_detail }}){% endif %}; check the path
{%- elif code is mapping -%}
error: source_too_large; source is {{ code.source_too_large.size }} bytes, exceeding the {{ code.source_too_large.ceiling }} byte read ceiling; continue with native tools
{%- elif code == "unknown_symbol" -%}
error: unknown_symbol{% if resolution_detail %} ({{ resolution_detail }}){% endif %}; no symbol matches that path or name; check the file with ide.outline or search a bare name with ide.symbol
{%- elif code == "provider_loading" -%}
error: provider_loading{% if resolution_detail %} ({{ resolution_detail }}){% endif %}; the language server is still loading the workspace; repeat the call in a few seconds
{%- elif code == "invalid_detail" and resolution_detail == "start:activation_conflict" -%}
error: invalid_detail (start:activation_conflict); this activation_id was used with another root; use a new activation_id
{%- elif code == "invalid_detail" -%}
error: invalid_detail{% if resolution_detail %} ({{ resolution_detail }}){% endif %}; {% if resolution_detail == "inspect:detail_expired" %}this detail_ref has expired{% else %}this detail_ref was never issued{% endif %}; repeat the original ide.* call to get a fresh one, or continue with native tools
{%- elif code == "source_unavailable" and resolution_detail == "inspect:source_changed" -%}
error: source_unavailable (inspect:source_changed); the file changed since this result was captured; call ide.context again for fresh bytes
{%- elif code == "source_unavailable" -%}
error: source_unavailable{% if resolution_detail %} ({{ resolution_detail }}){% endif %}; continue with native tools
{%- elif code == "outside_allowed_roots" -%}
error: outside_allowed_roots{% if resolution_detail %} ({{ resolution_detail }}){% endif %}; the working directory is not below any configured allowed root; start the IDE in an allowed directory or add this one to allowed_roots, otherwise continue with native tools
{%- elif code == "execution_profile" and cause_tag is defined -%}
error: execution_profile ({{ cause_tag }}); continue with native tools
{%- elif code == "path_context_retired" -%}
error: path_context_retired (context:path_mode); use ide.outline {"path"} for the skeleton or ide.read {"path","lines"} for a region; kind:"problems" is unchanged
{%- else -%}
error: {{ code }}{% if resolution_detail %} ({{ resolution_detail }}){% endif %}; continue with native tools
{%- endif -%}
{%- endif -%}
{%- if state == "invalid_parameters" -%}
{{ text }}
{%- endif -%}
{%- if state == "complete" and kind == "activation" -%}
complete activation: {{ text }}
Next: use ide.outline a file or ide.symbol a name
{%- endif -%}
{%- if state == "complete" and kind == "context" -%}
complete context: {{ text }}
{%- if truncated and detail_ref and continuation -%}
{{ "\n" }}Output is truncated; use ide.inspect with detail_ref {{ detail_ref }} before editing
{%- elif truncated and detail_ref -%}
{{ "\n" }}Output is incomplete; use ide.edit with source_ref {{ detail_ref }} when available, otherwise use the native editor
{%- elif truncated -%}
{{ "\n" }}Output is incomplete; use ide.edit when available, otherwise use the native editor
{%- elif detail_ref -%}
{{ "\n" }}Diagnostics are exactly as reported; use ide.edit with source_ref {{ detail_ref }} when available, otherwise use the native editor
{%- endif -%}
{%- endif -%}
{%- if state == "complete" and (kind == "outline" or kind == "read" or kind == "symbol" or kind == "graph" or kind == "test") -%}
{{ text }}
{%- if truncated and detail_ref and continuation -%}
{{ "\n" }}Output is truncated; use ide.inspect with detail_ref {{ detail_ref }} for the next page
{%- elif truncated -%}
{{ "\n" }}Output is incomplete
{%- endif -%}
{%- endif -%}
{%- if state == "complete" and kind == "diff" -%}
complete diff: {{ text }}
{%- if truncated and detail_ref and continuation -%}
{{ "\n" }}Output is truncated; use ide.inspect with detail_ref {{ detail_ref }}
{%- elif truncated -%}
{{ "\n" }}Output is incomplete; stop or review the available hunks safely with native tools
{%- else -%}
{{ "\n" }}Next: use ide.stop
{%- endif -%}
{%- endif -%}
{%- if state == "complete" and kind == "stop" -%}
complete stop: {{ text }}
Workspace authority is released; native edits remain on disk
{%- endif -%}
{%- if state == "edit" and result.outcome in ("created", "replaced", "unchanged") -%}
{%- set outcome = operation or result.outcome -%}
{%- if diagnostics.state == "current_reported" -%}
edit: {{ outcome }}; path {{ result.path }}; source_ref {{ result.source_ref }}; diagnostics: current_reported ({{ diagnostics.delta }}){{ " [truncated]" if diagnostics.truncated else "" }}
{{ diagnostics.messages|join("\n") }}
Next: use ide.edit with source_ref {{ result.source_ref }}
{%- elif diagnostics.state == "current_clean" -%}
edit: {{ outcome }}; path {{ result.path }}; source_ref {{ result.source_ref }}; diagnostics: current_clean. Next: use ide.diff
{%- elif diagnostics.state == "unknown" -%}
edit: {{ outcome }}; path {{ result.path }}; source_ref {{ result.source_ref }}; diagnostics: unknown. Next: use ide.context
{%- elif diagnostics.state == "pending" -%}
edit: {{ outcome }}; path {{ result.path }}; source_ref {{ result.source_ref }}; diagnostics: pending. Next: use ide.inspect with detail_ref {{ diagnostics.detail_ref }}
{%- endif -%}
{%- if note %}{{ "\n" }}{{ note }}{%- endif %}
{%- endif -%}
{%- if state == "edit" and result.outcome == "stale_source" -%}
edit: stale_source; path {{ result.path }}. No write occurred. The source reference is incomplete or unavailable for this binding, or the file content/presence changed since it was read; a newer observation alone does not invalidate unchanged content. Re-read the lines (ide.read) and retry with the new source_ref, and read every page of a paged read (ide.inspect) first
{%- endif -%}
{%- if state == "edit" and result.outcome == "conflicting_duplicate" -%}
edit: conflicting_duplicate; path {{ result.path }}. No write occurred; use ide.context to inspect the target before a new operation_id
{%- endif -%}
{%- if state == "edit" and result.outcome == "unsafe_target" -%}
edit: unsafe_target; path {{ result.path }}. No write occurred; continue with native tools
{%- endif -%}
{%- if state == "edit" and result.outcome in ("cancelled_no_effect", "deadline_no_effect", "capacity_no_effect") -%}
edit: {{ result.outcome }}; path {{ result.path }}. No write occurred
{%- endif -%}
{%- if state == "edit" and result.outcome == "outcome_unknown" -%}
edit: outcome_unknown; path {{ result.path }}. Inspect this target with native tools before any later mutation; do not replay this operation
{%- endif -%}
{%- if state == "edit" and result.outcome == "unavailable_before_dispatch" -%}
edit: unavailable_before_dispatch; path {{ result.path }}. No write was dispatched; continue with native tools
{%- endif -%}
