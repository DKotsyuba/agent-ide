{%- endif -%}
{%- if state == "error" -%}
{%- if code == "resolution_unverified" -%}
error: resolution_unverified (context:resolution); {{ resolution_detail if resolution_detail else "the project configuration did not prove this file belongs to the project" }}. Fix the project configuration, then retry ide.context
{%- elif code.no_such_file is defined -%}
