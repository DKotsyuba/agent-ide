{%- elif diagnostics.state == "current_clean" -%}
edit: {{ outcome }}; path {{ result.path }}; source_ref {{ result.source_ref }}; diagnostics: current_clean. Next: use ide.diff
{%- elif diagnostics.state == "unknown" -%}
edit: {{ outcome }}; path {{ result.path }}; source_ref {{ result.source_ref }}; diagnostics: unknown. Next: use ide.context
{%- elif diagnostics.state == "not_analysed" -%}
edit: {{ outcome }}; path {{ result.path }}; source_ref {{ result.source_ref }}; diagnostics: not_analysed ({{ diagnostics.reason }}); declare it, then edit again
{%- elif diagnostics.state == "pending" -%}
edit: {{ outcome }}; path {{ result.path }}; source_ref {{ result.source_ref }}; diagnostics: pending. Next: use ide.inspect with detail_ref {{ diagnostics.detail_ref }}
{%- endif -%}
{%- if note %}{{ "\n" }}{{ note }}{%- endif %}
{%- endif -%}
{%- if state == "edit" and result.outcome == "stale_source" -%}
edit: stale_source; path {{ result.path }}. No write occurred — this file changed or the source_ref missed part of its read. Re-read with ide.read and inspect every page before retrying{% if note %}{{ "\n" }}{{ note }}{% endif %}
{%- endif -%}
{%- if state == "edit" and result.outcome == "conflicting_duplicate" -%}
edit: conflicting_duplicate; path {{ result.path }}. No write occurred; use ide.context to inspect the target before a new operation_id
{%- endif -%}
{%- if state == "edit" and result.outcome == "unsafe_target" -%}
edit: unsafe_target; path {{ result.path }}. No write occurred — the target is a symlink or special file the IDE may not write. Continue with native tools
{%- endif -%}
{%- if state == "edit" and result.outcome in ("cancelled_no_effect", "deadline_no_effect", "capacity_no_effect") -%}
edit: {{ result.outcome }}; path {{ result.path }}. No write occurred. Retry with the same operation_id, or continue with native tools
{%- endif -%}
{%- if state == "edit" and result.outcome == "outcome_unknown" -%}
edit: outcome_unknown; path {{ result.path }}. Inspect this target with native tools before any later mutation; do not replay this operation
{%- endif -%}
{%- if state == "edit" and result.outcome == "unavailable_before_dispatch" -%}
edit: unavailable_before_dispatch; path {{ result.path }}. No write was dispatched because the IDE session was not active. Call ide.start and retry, or continue with native tools
{%- endif -%}
