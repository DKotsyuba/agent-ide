{%- elif code == "source_unavailable" -%}
error: source_unavailable{% if resolution_detail %} ({{ resolution_detail }}){% else %} (context:source_unavailable){% endif %}; the requested source could not be read. Retry ide.context, or continue with native tools
{%- elif code == "outside_allowed_roots" and resolution_detail is startingwith("start:root_absent") -%}
